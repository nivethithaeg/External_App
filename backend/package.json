{
  "name": "playnx-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "tsx scripts/dev-local.ts",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "check:razorpay": "tsx scripts/check-razorpay.ts",
    "check:smtp": "tsx scripts/check-smtp.ts",
    "backup": "tsx scripts/backup.ts",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@supabase/supabase-js": "^2.119.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.4"
  },
  "main": "server.js"
}
