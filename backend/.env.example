NODE_ENV=development
PORT=4000
# Supabase Postgres connection string (Project Settings > Database > Connection string, use the pooler URL)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_SSL=true
# Long random string (openssl rand -hex 48)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Supabase Storage (service role key: server-side ONLY)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=turf-media

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KickOff <no-reply@example.com>"

# Firebase Cloud Messaging (service account JSON, single line) - optional
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMS provider for mobile OTP (optional; without it OTPs are logged server-side in development only)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Google sign-in: OAuth Web client ID (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=

SUPABASE_PRIVATE_BUCKET=turf-private
# Set true to make mobile OTP mandatory for owners (needs an SMS gateway)
REQUIRE_PHONE_VERIFICATION=false
