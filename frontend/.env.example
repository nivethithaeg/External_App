# Backend base URL. Leave empty in dev to use the Vite proxy (/api -> localhost:4000).
VITE_API_URL=
VITE_GOOGLE_MAPS_KEY=
# Firebase web config (optional, enables push notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Google sign-in OAuth Web client ID (same ID as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Optional: shown in the footer / contact page when set
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=
VITE_SUPPORT_EMAIL=playnx.official@gmail.com
VITE_SUPPORT_PHONE=+91 90958 21333
