{
  "rewrites": [{ "source": "/api/(.*)", "destination": "https://api.YOUR-DOMAIN.com/api/$1" }, { "source": "/((?!assets/|icons/|sw.js|manifest.webmanifest|firebase-messaging-sw.js|favicon.svg).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }, { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }]
}
